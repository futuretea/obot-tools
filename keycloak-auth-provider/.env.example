# Keycloak Auth Provider Local Dev Configuration
# Copy to .env.local and customize, then: source .env.local && ./run-local.sh

# Required - Keycloak OIDC settings
export OAUTH2_PROXY_OIDC_ISSUER_URL="https://keycloak.example.com/realms/your-realm"
export OBOT_KEYCLOAK_AUTH_PROVIDER_CLIENT_ID="your-client-id"
export OBOT_KEYCLOAK_AUTH_PROVIDER_CLIENT_SECRET="your-client-secret"

# Cookie secret - generate with: openssl rand -base64 32
export OBOT_AUTH_PROVIDER_COOKIE_SECRET="your-base64-encoded-secret"

# Optional - obot server URL for redirects
export OBOT_SERVER_URL="http://localhost:8080"

# Optional - allowed email domains (* = all)
export OBOT_AUTH_PROVIDER_EMAIL_DOMAINS="*"

# Optional - listen port
export PORT="9999"

# Optional - Enable Admin API group search (default: true)
# Requires users to have realm-management roles in Keycloak
# Set to "false" to disable
export OBOT_KEYCLOAK_GROUP_SEARCH_ENABLED="true"

# Debug mode - set to "true" to see groups extraction logs
export OBOT_AUTH_DEBUG="true"
