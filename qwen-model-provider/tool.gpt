Name: Qwen
Description: Model Provider for Qwen
Model Provider: true
Credential: ../placeholder-credential as qwen-model-provider with OBOT_QWEN_MODEL_PROVIDER_BASE_URL;OBOT_QWEN_MODEL_PROVIDER_API_KEY;OBOT_QWEN_MODEL_PROVIDER_ENABLE_THINKING as env_vars
Metadata: noUserAuth: qwen-model-provider

#!sys.daemon ${GPTSCRIPT_TOOL_DIR}/bin/gptscript-go-tool

---
!metadata:Qwen:providerMeta
{
    "icon": "https://avatars.githubusercontent.com/u/141221163?s=48&v=4",
    "link": "https://github.com/QwenLM/Qwen",
    "dialect": "OpenAIChatCompletions",
    "description": "Model Provider for Qwen models via any OpenAI-compatible API endpoint.",
    "envVars": [
        {
            "name": "OBOT_QWEN_MODEL_PROVIDER_BASE_URL",
            "friendlyName": "Base URL",
            "description": "Base URL for the Qwen OpenAI-compatible API.",
            "sensitive": false
        },
        {
            "name": "OBOT_QWEN_MODEL_PROVIDER_API_KEY",
            "friendlyName": "API Key",
            "description": "API Key for the Qwen API.",
            "sensitive": true
        }
    ],
    "optionalEnvVars": [
        {
            "name": "OBOT_QWEN_MODEL_PROVIDER_ENABLE_THINKING",
            "friendlyName": "Enable Thinking",
            "description": "Set to 'true' to enable thinking/reasoning mode for Qwen3 models, or 'false' to explicitly disable it. If not set, the parameter will not be sent.",
            "sensitive": false
        }
    ]
}

---
Name: validate
Description: Validate the Qwen API key

#!${GPTSCRIPT_TOOL_DIR}/bin/gptscript-go-tool validate
